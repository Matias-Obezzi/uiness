{
  "name": "@uiness/card-validator",
  "version": "0.0.0",
  "description": "Payment card checks for the server, and the bank behind a card from its first digits: brand, debit or credit, issuer and country, through a cached endpoint of your own.",
  "keywords": [
    "credit-card",
    "card",
    "validation",
    "luhn",
    "bin",
    "iin",
    "issuer",
    "binlist",
    "react",
    "uiness"
  ],
  "author": "Matías Obezzi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Matias-Obezzi/uiness.git",
    "directory": "packages/card-validator"
  },
  "homepage": "https://uiness.vercel.app/docs/card-validator",
  "bugs": "https://github.com/Matias-Obezzi/uiness/issues",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.mts",
        "default": "./dist/react.mjs"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsdown": "^0.23.0",
    "vitest": "^5.0.0"
  }
}
