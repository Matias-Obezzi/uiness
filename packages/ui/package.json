{
  "name": "@uiness/ui",
  "version": "0.0.0",
  "private": true,
  "description": "uiness component registry: Radix + Tailwind components installed with the shadcn CLI.",
  "type": "module",
  "scripts": {
    "build": "shadcn build registry.json --output public/r",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@uiness/fx": "workspace:*",
    "@uiness/image": "workspace:*",
    "@uiness/island": "workspace:*",
    "@uiness/scroll": "workspace:*",
    "@uiness/toast": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.40.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "jsdom": "^30.0.1",
    "shadcn": "^4.20.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
