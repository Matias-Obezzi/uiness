{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "uiness",
  "homepage": "https://matias-obezzi.github.io/uiness",
  "items": [
    {
      "name": "theme",
      "type": "registry:theme",
      "title": "uiness theme",
      "description": "Neutral theme with the same variable names as shadcn/ui, so both registries mix freely. Adds a layer scale, motion durations and easings, and a type scale.",
      "dependencies": ["tw-animate-css"],
      "css": {
        "@layer base": {
          ":root": {
            "--z-raised": "10",
            "--z-sticky": "40",
            "--z-overlay": "50",
            "--z-popover": "60",
            "--z-toast": "70",
            "--z-tooltip": "80",
            "--z-drag": "90",
            "--z-island": "100",
            "--duration-instant": "100ms",
            "--duration-fast": "150ms",
            "--duration-normal": "200ms",
            "--duration-slow": "300ms",
            "--duration-slower": "500ms",
            "--easing-standard": "cubic-bezier(0.2, 0, 0, 1)",
            "--easing-emphasized": "cubic-bezier(0.16, 1, 0.3, 1)",
            "--easing-exit": "cubic-bezier(0.3, 0, 0.8, 0.15)",
            "--easing-sheet": "cubic-bezier(0.32, 0.72, 0, 1)",
            "--easing-spring": "linear(0, 0.4 20%, 1.1 50%, 0.96 70%, 1)"
          }
        },
        "@media (prefers-reduced-motion: reduce)": {
          "*, ::before, ::after": {
            "animation-duration": "0.01ms !important",
            "animation-iteration-count": "1 !important",
            "transition-duration": "0.01ms !important",
            "scroll-behavior": "auto !important"
          }
        }
      },
      "cssVars": {
        "theme": {
          "radius": "0.75rem",
          "ease-standard": "var(--easing-standard)",
          "ease-emphasized": "var(--easing-emphasized)",
          "ease-exit": "var(--easing-exit)",
          "ease-sheet": "var(--easing-sheet)",
          "ease-spring": "var(--easing-spring)",
          "font-sans": "ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", sans-serif",
          "font-mono": "ui-monospace, SFMono-Regular, \"SF Mono\", Menlo, Consolas, \"Liberation Mono\", monospace",
          "text-display": "clamp(2.5rem, 1.6rem + 3.6vw, 4.5rem)",
          "text-display--line-height": "1.05",
          "text-display--letter-spacing": "-0.035em",
          "text-display--font-weight": "700",
          "text-title": "clamp(1.875rem, 1.5rem + 1.5vw, 2.5rem)",
          "text-title--line-height": "1.15",
          "text-title--letter-spacing": "-0.025em",
          "text-title--font-weight": "700",
          "text-heading": "1.5rem",
          "text-heading--line-height": "1.25",
          "text-heading--letter-spacing": "-0.02em",
          "text-heading--font-weight": "600",
          "text-subheading": "1.125rem",
          "text-subheading--line-height": "1.4",
          "text-subheading--letter-spacing": "-0.01em",
          "text-subheading--font-weight": "600",
          "text-lead": "1.25rem",
          "text-lead--line-height": "1.6",
          "text-body": "1rem",
          "text-body--line-height": "1.7",
          "text-caption": "0.8125rem",
          "text-caption--line-height": "1.4",
          "text-caption--letter-spacing": "0.01em",
          "text-eyebrow": "0.75rem",
          "text-eyebrow--line-height": "1rem",
          "text-eyebrow--letter-spacing": "0.08em",
          "text-eyebrow--font-weight": "600"
        },
        "light": {
          "background": "oklch(1 0 0)",
          "foreground": "oklch(0.145 0 0)",
          "card": "oklch(1 0 0)",
          "card-foreground": "oklch(0.145 0 0)",
          "popover": "oklch(1 0 0)",
          "popover-foreground": "oklch(0.145 0 0)",
          "primary": "oklch(0.205 0 0)",
          "primary-foreground": "oklch(0.985 0 0)",
          "secondary": "oklch(0.97 0 0)",
          "secondary-foreground": "oklch(0.205 0 0)",
          "muted": "oklch(0.97 0 0)",
          "muted-foreground": "oklch(0.556 0 0)",
          "accent": "oklch(0.97 0 0)",
          "accent-foreground": "oklch(0.205 0 0)",
          "destructive": "oklch(0.577 0.245 27.325)",
          "border": "oklch(0.922 0 0)",
          "input": "oklch(0.922 0 0)",
          "ring": "oklch(0.708 0 0)"
        },
        "dark": {
          "background": "oklch(0.145 0 0)",
          "foreground": "oklch(0.985 0 0)",
          "card": "oklch(0.205 0 0)",
          "card-foreground": "oklch(0.985 0 0)",
          "popover": "oklch(0.205 0 0)",
          "popover-foreground": "oklch(0.985 0 0)",
          "primary": "oklch(0.922 0 0)",
          "primary-foreground": "oklch(0.205 0 0)",
          "secondary": "oklch(0.269 0 0)",
          "secondary-foreground": "oklch(0.985 0 0)",
          "muted": "oklch(0.269 0 0)",
          "muted-foreground": "oklch(0.708 0 0)",
          "accent": "oklch(0.269 0 0)",
          "accent-foreground": "oklch(0.985 0 0)",
          "destructive": "oklch(0.704 0.191 22.216)",
          "border": "oklch(1 0 0 / 10%)",
          "input": "oklch(1 0 0 / 15%)",
          "ring": "oklch(0.556 0 0)"
        }
      },
      "files": []
    },
