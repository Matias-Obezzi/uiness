{
  "name": "@uiness/image",
  "version": "0.0.0",
  "description": "React image component with loading transitions: blur, pixelate, fade, reveal, with optional real download progress.",
  "keywords": [
    "react",
    "image",
    "lazy",
    "blur",
    "placeholder",
    "progressive",
    "pixelate",
    "uiness"
  ],
  "author": "Mat\u00edas Obezzi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matiasobezzi/uiness.git",
    "directory": "packages/image"
  },
  "homepage": "https://matiasobezzi.github.io/uiness/docs/image",
  "bugs": "https://github.com/matiasobezzi/uiness/issues",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsdown": "^0.23.0",
    "vitest": "^5.0.0"
  }
}
