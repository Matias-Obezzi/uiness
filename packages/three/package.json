{
  "name": "@uiness/three",
  "version": "0.2.0",
  "description": "Headless Three.js viewer and stage for React: 3D model viewer with orbit controls, lighting, contact shadows, render on demand, and lazy loading. Zero dependencies beyond Three.js.",
  "keywords": [
    "react",
    "three",
    "threejs",
    "3d",
    "gltf",
    "viewer",
    "orbit-controls",
    "uiness"
  ],
  "author": "Matías Obezzi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Matias-Obezzi/uiness.git",
    "directory": "packages/three"
  },
  "homepage": "https://uiness.vercel.app/docs/three",
  "bugs": "https://github.com/Matias-Obezzi/uiness/issues",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core.d.mts",
        "default": "./dist/core.mjs"
      },
      "require": {
        "types": "./dist/core.d.cts",
        "default": "./dist/core.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18",
    "three": ">=0.170"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.186.0",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.186.1",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
