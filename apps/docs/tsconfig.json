{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "checkJs": true,
    "types": ["vite/client", "node"],
    "paths": {
      "@uiness/image": ["../../packages/image/src/index.ts"],
      "@uiness/island": ["../../packages/island/src/index.ts"],
      "@uiness/fx": ["../../packages/fx/src/index.ts"],
      "@/components/ui/*": ["../../packages/ui/registry/ui/*"],
      "@/*": ["../../packages/ui/registry/*"],
      "~/*": ["./src/*"],
      "@uiness/toast": ["../../packages/toast/src/index.ts"],
      "@uiness/scroll": ["../../packages/scroll/src/index.ts"],
      "@uiness/dnd": ["../../packages/dnd/src/index.ts"],
      "@uiness/choreo": ["../../packages/choreo/src/index.ts"]
    }
  },
  "include": ["src", "api", "test", "scripts/**/*.ts", "vite.config.ts", "vitest.config.ts"]
}
